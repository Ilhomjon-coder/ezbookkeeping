# Copy to .env and fill in real values before `docker compose up -d`.
# Never commit .env — it contains secrets.

# --- Domain & HTTPS --------------------------------------------------------
# Public hostname pointed at this droplet (A/AAAA record on your DNS).
DOMAIN=ezbookkeeping.example.com
# Email used by Let's Encrypt for cert expiry notices.
ACME_EMAIL=admin@example.com

# --- Container image -------------------------------------------------------
# Override to pin a specific tag, e.g. ghcr.io/ilhomjon-coder/ezbookkeeping:v1.5.1
EZBK_IMAGE=ghcr.io/ilhomjon-coder/ezbookkeeping:latest

# --- Application secret ----------------------------------------------------
# Used to sign session JWTs. Generate once and keep stable; rotating logs everyone out.
# Generate with: openssl rand -hex 32
SECRET=replace-me-with-openssl-rand-hex-32

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=ezbookkeeping
POSTGRES_USER=ezbookkeeping
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=replace-me

# --- Optional: SMTP for password reset / email verification ----------------
ENABLE_SMTP=false
SMTP_HOST=smtp.example.com:587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ezbookkeeping@example.com

# --- Timezone --------------------------------------------------------------
TZ=Asia/Tashkent
